#!/bin/sh
# Build the mod and package it, locally (nothing is uploaded anywhere):
# - dist/mcopt-VERSION.jar, the single-jar install (tools/bundle.py): the Metal mod with natives inside. Put it in the mods folder; this build runs without Sodium.
# - dist/mcopt-VERSION.zip: mcopt-VERSION/{mcopt-VERSION.jar, README.txt, LICENSE, NOTICE}, the same jar byte for
#   byte (README.txt is RELEASE-README.txt with the version filled in).
# Usage: tools/release
set -eu
cd "$(dirname "$0")/.."
die() { echo "$*" >&2; exit 1; }
version=$(sed -n "s/^version = '\(.*\)'$/\1/p" metal/build.gradle)
[ -n "$version" ] || die "No version in metal/build.gradle."
./gradlew --no-daemon :metal:build -q --console=plain
jar=metal/build/libs/metal-$version.jar
[ -f "$jar" ] || die "The build made no $jar."
name=mcopt-$version
mkdir -p dist
python3 tools/bundle.py --metal "$jar" --out "dist/mcopt-$version.jar"
rm -rf "dist/$name" "dist/$name.zip"
mkdir -p "dist/$name"
cp "dist/mcopt-$version.jar" "dist/$name/mcopt-$version.jar"
cp LICENSE NOTICE "dist/$name/"
sed "s/@VERSION@/$version/g" RELEASE-README.txt > "dist/$name/README.txt"
(cd dist && zip -qrX "$name.zip" "$name")
echo "dist/$name.zip"
